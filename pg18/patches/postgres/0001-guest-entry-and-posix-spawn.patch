diff --git a/src/backend/postmaster/launch_backend.c b/src/backend/postmaster/launch_backend.c
--- a/src/backend/postmaster/launch_backend.c
+++ b/src/backend/postmaster/launch_backend.c
@@ -32,6 +32,12 @@
 #include "postgres.h"
 
 #include <unistd.h>
+#ifdef HYPERLIGHT_UNIKRAFT
+#include <spawn.h>
+#ifndef EXEC_BACKEND
+#error HYPERLIGHT_UNIKRAFT requires EXEC_BACKEND
+#endif
+#endif
 
 #include "libpq/libpq-be.h"
 #include "miscadmin.h"
@@ -387,6 +393,26 @@ internal_forkexec(const char *child_kind, int child_slot,
 	argv[2] = tmpfilename;
 	argv[3] = NULL;
 
+#ifdef HYPERLIGHT_UNIKRAFT
+	{
+		int			rc;
+
+		fflush(NULL);
+		rc = posix_spawn(&pid, postgres_exec_path, NULL, NULL, argv, environ);
+		if (rc != 0)
+		{
+			if (unlink(tmpfilename) != 0)
+				ereport(LOG,
+						(errmsg("could not remove child parameter file \"%s\": %m",
+								tmpfilename)));
+			errno = rc;
+			ereport(LOG,
+					(errmsg("could not spawn server process \"%s\": %m",
+							postgres_exec_path)));
+			return -1;
+		}
+	}
+#else
 	/* Fire off execv in child */
 	if ((pid = fork_process()) == 0)
 	{
@@ -399,6 +425,7 @@ internal_forkexec(const char *child_kind, int child_slot,
 			exit(1);
 		}
 	}
+#endif
 
 	return pid;					/* Parent returns pid, or -1 on fork failure */
 }
diff --git a/src/backend/postmaster/postmaster.c b/src/backend/postmaster/postmaster.c
--- a/src/backend/postmaster/postmaster.c
+++ b/src/backend/postmaster/postmaster.c
@@ -1468,12 +1468,16 @@ getInstallationPaths(const char *argv0)
 				(errmsg("%s: could not locate my own executable path", argv0)));
 
 #ifdef EXEC_BACKEND
+#ifdef HYPERLIGHT_UNIKRAFT
+	strlcpy(postgres_exec_path, my_exec_path, MAXPGPATH);
+#else
 	/* Locate executable backend before we change working directory */
 	if (find_other_exec(argv0, "postgres", PG_BACKEND_VERSIONSTR,
 						postgres_exec_path) < 0)
 		ereport(FATAL,
 				(errmsg("%s: could not locate matching postgres executable",
 						argv0)));
+#endif
 #endif
 
